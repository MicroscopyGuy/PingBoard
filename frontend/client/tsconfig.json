{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "moduleResolution": "nodenext",
    "lib": ["es2015"]

  },
  "display": "Recommended",
  "$schema": "https://json.schemastore.org/tsconfig"
}